---
import { Image } from "astro:assets";
import { customerStoryPath, publishedStories } from "@/data/customer-stories";
import "@/styles/customer-stories.css";
import StoryComparison from "./StoryComparison.astro";
interface Props {
  headingLevel?: "h2" | "h3";
  compact?: boolean;
}
const { headingLevel: Heading = "h2", compact = false } = Astro.props;
const imageSizes = compact
  ? "(min-width: 1240px) 285px, (min-width: 1180px) calc((100vw - 100px) / 4), (min-width: 890px) calc((100vw - 80px) / 3), (min-width: 600px) calc((100vw - 60px) / 2), calc(100vw - 32px)"
  : "(max-width: 760px) 92vw, 46vw";
---
<div class:list={["case-index-grid", { "case-index-grid--compact": compact }]} data-customer-story-cards>
  {publishedStories.map(study => (
    <a
      class="case-preview-card"
      href={customerStoryPath(study.slug)}
      data-story-industry={compact ? study.sector : undefined}
    >
      <div class={`case-card-image ${study.theme}`}>
        <Image src={study.image} alt={study.imageAlt} widths={[480, 800, 1200]} sizes={imageSizes} />
      </div>
      <div class="case-card-copy">
        <div class="case-card-intro">
          <p class="case-kicker">{study.sector}</p>
          <Heading>{study.client} <span aria-hidden="true">↗</span></Heading>
          <p>{study.summary}</p>
          {compact && study.useCases?.length ? (
            <ul class="case-card-tags" aria-label="Use cases">
              {study.useCases.map(useCase => <li data-story-tag={useCase}>{useCase}</li>)}
            </ul>
          ) : null}
        </div>
        {compact && study.comparedTo?.length ? <StoryComparison products={study.comparedTo} placement="card" /> : null}
        <span class="case-text-link">Read {study.proposedQuote.approvalName}’s story <span aria-hidden="true">→</span></span>
      </div>
    </a>
  ))}
</div>

<style>
  .case-index-grid--compact {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 20px;
  }

  .case-index-grid--compact .case-preview-card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 0;
    min-width: 0;
  }

  .case-index-grid--compact .case-preview-card[hidden] { display: none; }
  .case-index-grid--compact .case-card-image { aspect-ratio: 16 / 9; }
  .case-index-grid--compact .case-card-image img { object-fit: contain; }
  .case-index-grid--compact .case-card-image.venue img { object-fit: cover; }

  .case-index-grid--compact .case-card-copy {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0;
    padding: 18px;
  }

  .case-index-grid--compact .case-kicker { margin-bottom: 8px !important; }

  .case-index-grid--compact h2 {
    font-size: 20px;
    line-height: 1.25;
    gap: 10px;
    margin-bottom: 10px;
  }

  .case-index-grid--compact .case-card-intro > p:not(.case-kicker) {
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .case-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding: 0;
    margin: 0 0 14px;
    list-style: none;
  }

  .case-card-tags li {
    border-radius: 5px;
    background: #e7f5f0;
    color: #27584c;
    padding: 4px 7px;
    font-size: 11px;
    line-height: 1.4;
  }

  .case-index-grid--compact .case-text-link { grid-row: 3; }
</style>
