---
import { Image } from "astro:assets";
import { customerStoryPath, publishedStories } from "@/data/customer-stories";
import "@/styles/customer-stories.css";
interface Props { headingLevel?: "h2" | "h3"; }
const { headingLevel: Heading = "h2" } = Astro.props;
---
<div class="case-index-grid" data-customer-story-cards>
  {publishedStories.map(study => <a class="case-preview-card" href={customerStoryPath(study.slug)}>
    <div class={`case-card-image ${study.theme}`}><Image src={study.image} alt={study.imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 92vw, 46vw" /></div>
    <div class="case-card-copy"><p class="case-kicker">{study.sector}</p><Heading>{study.client} <span aria-hidden="true">↗</span></Heading><p>{study.summary}</p><span class="case-text-link">Read {study.proposedQuote.approvalName}’s story <span aria-hidden="true">→</span></span></div>
  </a>)}
</div>
