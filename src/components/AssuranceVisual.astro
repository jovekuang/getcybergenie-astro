---
interface Props {
  variant: "workflow" | "managed" | "partner";
}

const instanceId = crypto.randomUUID();
const { variant } = Astro.props;

const managedOuterPath = "M84 30H276C306 30 326 50 326 80C326 110 306 130 276 130H84C54 130 34 110 34 80C34 50 54 30 84 30Z";
const managedInnerPath = "M88 50H272C290 50 302 62 302 80C302 98 290 110 272 110H88C70 110 58 98 58 80C58 62 70 50 88 50Z";
---

<svg
  class:list={["assurance-visual", `assurance-visual-${variant}`]}
  viewBox="0 0 360 160"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id={`assurance-packet-glow-${variant}-${instanceId}`} x="-250%" y="-250%" width="600%" height="600%">
      <feGaussianBlur stdDeviation="2.8" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  {variant === "workflow" && (
    <>
      <g class="assurance-guide-lines">
        <path d="M18 40H342M18 80H342M18 120H342" />
      </g>
      <g class="workflow-lines">
        <path d="M28 38H82C116 38 118 80 154 80" />
        <path d="M28 80H154" />
        <path d="M28 122H82C116 122 118 80 154 80" />
        <path d="M206 80H326" />
      </g>
      <g class="workflow-packets">
        {[
          "M28 38H82C116 38 118 80 154 80",
          "M28 80H154",
          "M28 122H82C116 122 118 80 154 80",
          "M206 80H326",
        ].map((path, index) => (
          <g class="signal-packet" filter={`url(#assurance-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-6" cy="0" rx="8" ry="1.6" />
            <circle class="signal-packet-halo" r="4.8" />
            <circle class="signal-packet-core" r="1.6" />
            <animateMotion path={path} dur={`${4.4 + index * 0.35}s`} begin={`-${index * 1.05}s`} rotate="auto" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.88;1" dur={`${4.4 + index * 0.35}s`} begin={`-${index * 1.05}s`} repeatCount="indefinite" />
          </g>
        ))}
      </g>
      <g class="workflow-nodes">
        <circle cx="28" cy="38" r="5" />
        <rect x="23" y="75" width="10" height="10" rx="2" />
        <path d="M28 116v12M22 122h12" />
        <rect class="workflow-core" x="154" y="58" width="52" height="44" rx="5" />
        <path class="workflow-core-mark" d="M168 80h24M180 68v24" />
        <circle class="workflow-output" cx="332" cy="80" r="6" />
      </g>
    </>
  )}

  {variant === "managed" && (
    <>
      <g class="managed-orbits">
        <rect x="34" y="30" width="292" height="100" rx="50" pathLength="100" />
        <rect class="managed-orbit-inner" x="58" y="50" width="244" height="60" rx="30" pathLength="100" />
      </g>
      <g class="managed-packets">
        {[managedOuterPath, managedInnerPath].map((path, index) => (
          <g class="signal-packet" filter={`url(#assurance-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-6" cy="0" rx="8" ry="1.6" />
            <circle class="signal-packet-halo" r="4.8" />
            <circle class="signal-packet-core" r="1.6" />
            <animateMotion path={path} dur={index === 0 ? "7.4s" : "5.8s"} begin={index === 0 ? "-2.4s" : "-4.6s"} rotate="auto" repeatCount="indefinite" />
          </g>
        ))}
      </g>
      <g class="managed-status">
        <rect x="153" y="62" width="54" height="36" rx="5" />
        <path d="M166 75h28M166 85h18" />
      </g>
      <g class="managed-checkpoints">
        <circle cx="82" cy="40" r="5" />
        <circle cx="278" cy="40" r="5" />
        <circle cx="278" cy="120" r="5" />
        <circle class="managed-checkpoint-live" cx="82" cy="120" r="6" />
      </g>
      <g class="managed-arrows">
        <path d="M176 30l8-5m-8 5 8 5" />
        <path d="M184 130l-8-5m8 5-8 5" />
      </g>
    </>
  )}

  {variant === "partner" && (
    <>
      <g class="assurance-guide-lines">
        <path d="M18 40H342M18 80H342M18 120H342" />
      </g>
      <g class="partner-lines">
        <path d="M34 38H92C124 38 126 80 158 80" />
        <path d="M34 80H158" />
        <path d="M34 122H92C124 122 126 80 158 80" />
        <path d="M202 80H314" />
      </g>
      <g class="partner-packets">
        {[
          "M34 38H92C124 38 126 80 158 80",
          "M34 80H158",
          "M34 122H92C124 122 126 80 158 80",
          "M202 80H314",
        ].map((path, index) => (
          <g class="signal-packet" filter={`url(#assurance-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-6" cy="0" rx="8" ry="1.6" />
            <circle class="signal-packet-halo" r="4.8" />
            <circle class="signal-packet-core" r="1.6" />
            <animateMotion path={path} dur={`${4.2 + index * 0.4}s`} begin={`-${index * 1.15}s`} rotate="auto" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.88;1" dur={`${4.2 + index * 0.4}s`} begin={`-${index * 1.15}s`} repeatCount="indefinite" />
          </g>
        ))}
      </g>
      <g class="partner-inputs">
        <rect x="27" y="31" width="14" height="14" rx="3" />
        <circle cx="34" cy="80" r="7" />
        <path d="M34 114l8 8-8 8-8-8 8-8Z" />
      </g>
      <g class="partner-hub">
        <rect x="158" y="58" width="44" height="44" rx="8" />
        <path d="M170 80h20M180 70v20" />
      </g>
      <g class="partner-result">
        <circle cx="326" cy="80" r="12" />
        <path d="m320 80 4 4 8-9" />
      </g>
    </>
  )}
</svg>
