---
import { brand } from "@/data/brand";
---

<nav class="footer-social-links" aria-label="Follow Cyber Genie">
  {brand.socialLinks.map(({ name, icon, url }) => (
    <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Cyber Genie on ${name} (opens in a new tab)`} title={name}>
      <img src={`/icons/social/${icon}.svg`} width="20" height="20" alt="" aria-hidden="true" loading="lazy" />
    </a>
  ))}
</nav>

<style>
  .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .footer-social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 10px;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .footer-social-links a:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.7);
  }

  .footer-social-links a:focus-visible {
    outline: 3px solid #a9e1d2;
    outline-offset: 3px;
  }

  .footer-social-links img {
    filter: brightness(0) invert(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social-links a { transition: none; }
  }
</style>
