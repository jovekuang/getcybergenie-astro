---
import { heroIndustries, positioning } from "@/data/positioning";
const icons: Record<string, string> = {
  "online-retailers": "M5 7h14l1 14H4L5 7ZM8 8V6a4 4 0 018 0v2",
  "hvac-contractors": "M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9 5l3 3 3-3M9 19l3-3 3 3",
  "realtors": "M3 11l9-8 9 8M5 10v11h14V10M10 21v-7h4v7",
  "plumbers": "M12 3C10 7 5 11 5 15a7 7 0 0014 0c0-4-5-8-7-12ZM8 15a4 4 0 004 4",
  "property-management": "M4 21V5h10v16M14 10h6v11M8 9h2M8 13h2M8 17h2M17 14h0M17 18h0M2 21h20",
  "electricians": "M13 2L4 14h7l-1 8 10-13h-8l1-7Z",
  "auto-repair-shops": "M3 15v-4l3-6h12l3 6v7H3v-3ZM3 11h18M6 15h2M16 15h2M5 18v3M19 18v3",
  "medspas": "M12 3c-4 4-5 8 0 12 5-4 4-8 0-12ZM12 21C5 21 2 16 3 10c5 0 8 4 9 11ZM12 21c7 0 10-5 9-11-5 0-8 4-9 11Z",
  "day-cares": "M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2 2M16.4 16.4l2 2M5.6 18.4l2-2M16.4 7.6l2-2M16 12a4 4 0 11-8 0 4 4 0 018 0Z",
  "animal-hospitals": "M12 12c-2 0-6 4-6 6s3 3 6 1c3 2 6 1 6-1s-4-6-6-6ZM6 7a2 3 0 110 6 2 3 0 010-6ZM18 7a2 3 0 110 6 2 3 0 010-6ZM10 2a2 3 0 110 6 2 3 0 010-6ZM15 2a2 3 0 110 6 2 3 0 010-6Z",
  "insurance-agencies": "M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3ZM8 12l3 3 5-6",
};
const palettes = [
  { accent: "#3e46b6", tint: "#eeefff" },
  { accent: "#653da5", tint: "#f3edfc" },
  { accent: "#246880", tint: "#eaf5f8" },
];
---
<section class="hero-industries" data-industry-carousel aria-labelledby="hero-industries-title">
  <div class="hero-industries-heading">
    <h2 id="hero-industries-title">{positioning.audience}</h2>
    <a href="/industries/">View all industries <span aria-hidden="true">→</span></a>
  </div>
  <div class="industry-carousel-viewport" data-industry-viewport>
    <ul class="industry-carousel-track" id="hero-industry-track" data-industry-track>
      {heroIndustries.map((industry, index) => (
        <li data-industry-tile style={`--tile-accent: ${palettes[industry.slug === 'online-retailers' ? 0 : index % palettes.length].accent}; --tile-tint: ${palettes[industry.slug === 'online-retailers' ? 0 : index % palettes.length].tint}`}>
          <a href={industry.href}>
            <span class="industry-tile-heading">
              <span class="industry-tile-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[industry.slug]} /></svg>
              </span>
              <span class="industry-tile-label">{industry.name}</span>
            </span>
            <strong>{industry.outcome}</strong>
            <span class="industry-tile-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="industry-carousel-controls" data-industry-controls hidden>
    <button type="button" data-industry-previous aria-label="Previous industry" aria-controls="hero-industry-track">←</button>
    <button type="button" data-industry-toggle aria-controls="hero-industry-track">Pause scrolling</button>
    <button type="button" data-industry-next aria-label="Next industry" aria-controls="hero-industry-track">→</button>
  </div>
</section>

<script>
  import { initializeIndustryCarousel } from "@/scripts/industryCarousel";
  document.querySelectorAll<HTMLElement>("[data-industry-carousel]").forEach(initializeIndustryCarousel);
</script>
