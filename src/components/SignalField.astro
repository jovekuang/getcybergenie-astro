---
interface Props {
  variant?: "hero" | "get" | "win" | "keep" | "accent";
  animated?: boolean;
}

const instanceId = crypto.randomUUID();
const { variant = "hero", animated = true } = Astro.props;

const heroRoots = [504, 554, 604];
const heroBranches = Array.from({ length: 48 }, (_, index) => {
  const root = Math.floor(index / 16);
  const position = index % 16;
  const rootY = heroRoots[root];
  const endY = 18 + root * 240 + position * 13.6;

  return {
    d: `M620 ${rootY} C790 ${rootY} 900 ${endY} 1080 ${endY} H1640`,
    root,
    position,
    tone: index % 7,
    endY,
    pulse: position === 3 || position === 8 || position === 13,
  };
});
const accentBranches = heroBranches.filter((branch) => branch.position % 2 === 1);

const visibilityMarkers = [
  [64, 58, "square"], [416, 58, "square"],
  [120, 38, "plus"], [360, 38, "plus"],
  [180, 70, "circle"], [300, 70, "circle"],
  [88, 120, "circle"], [392, 120, "circle"],
  [150, 112, "square"], [330, 112, "square"],
  [198, 94, "plus"], [282, 94, "plus"],
  [64, 182, "plus"], [416, 182, "plus"],
  [120, 202, "square"], [360, 202, "square"],
  [180, 172, "circle"], [300, 172, "circle"],
] as const;

const winLanes = [42, 68, 94, 120, 146, 172, 198];
const loopOuter = "M142 42H338C392 42 426 72 426 120C426 168 392 198 338 198H142C88 198 54 168 54 120C54 72 88 42 142 42Z";
const loopInner = "M150 64H330C374 64 400 84 400 120C400 156 374 176 330 176H150C106 176 80 156 80 120C80 84 106 64 150 64Z";
---

<svg
  class:list={["signal-field", `signal-field-${variant}`, { "is-animated": animated }]}
  viewBox={variant === "hero" || variant === "accent" ? "0 0 1600 720" : "0 0 480 240"}
  preserveAspectRatio={variant === "hero" || variant === "accent" ? "xMidYMid slice" : "xMidYMid meet"}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id={`signal-packet-glow-${variant}-${instanceId}`} x="-250%" y="-250%" width="600%" height="600%">
      <feGaussianBlur stdDeviation="3.2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
    {variant === "get" && (
      <linearGradient id={`visibility-sweep-gradient-${instanceId}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#176cff" stop-opacity="0" />
        <stop offset="0.42" stop-color="#176cff" stop-opacity="0.08" />
        <stop offset="0.5" stop-color="#73a7ff" stop-opacity="0.55" />
        <stop offset="0.58" stop-color="#176cff" stop-opacity="0.08" />
        <stop offset="1" stop-color="#176cff" stop-opacity="0" />
      </linearGradient>
    )}
  </defs>

  {variant === "hero" && (
    <>
      <g class="hero-grid-lines">
        {[600, 720, 840, 960, 1080, 1200, 1320, 1440, 1560].map((x) => <path d={`M${x} 0V720`} />)}
        {[144, 240, 336, 432, 528, 624].map((y) => <path d={`M520 ${y}H1600`} />)}
      </g>

      <g class="hero-trunks">
        {heroRoots.map((y, index) => (
          <>
            <path class:list={[{ "is-blue": index === 1 }]} d={`M170 ${y}H620`} />
            <rect class:list={[{ "is-blue": index === 1 }]} x="169" y={y - 6} width="12" height="12" />
            <circle class:list={["trunk-beacon", { "is-blue": index === 1 }]} cx="440" cy={y} r="4" />
          </>
        ))}
      </g>

      <g class="hero-branches">
        {heroBranches.map((branch) => (
          <path class:list={["hero-branch-base", `flow-tone-${branch.tone}`]} d={branch.d} />
        ))}
        {heroBranches.filter((branch) => animated && branch.pulse).map((branch, index) => (
          <g class="signal-packet hero-signal-packet" filter={`url(#signal-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-7" cy="0" rx="9" ry="1.8" />
            <circle class="signal-packet-halo" r="5.5" />
            <circle class="signal-packet-core" r="1.8" />
            <animateMotion
              path={branch.d}
              dur={`${6.2 + (index % 3) * 0.7}s`}
              begin={`-${branch.root * 1.2 + (branch.position % 5) * 0.38}s`}
              rotate="auto"
              repeatCount="indefinite"
            />
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.88;1" dur={`${6.2 + (index % 3) * 0.7}s`} begin={`-${branch.root * 1.2 + (branch.position % 5) * 0.38}s`} repeatCount="indefinite" />
          </g>
        ))}
      </g>

      <g class="hero-track-nodes">
        {heroBranches.filter((_, index) => index % 2 === 0).map((branch, index) => (
          <rect
            class="hero-track-node"
            x={1160 + (index % 4) * 112}
            y={branch.endY - 3}
            width="6"
            height="6"
          />
        ))}
      </g>
    </>
  )}

  {variant === "get" && (
    <>
      <g class="visibility-guides">
        <path d="M22 80C118 20 362 20 458 80" />
        <path d="M22 160C118 220 362 220 458 160" />
        <path d="M24 120H456" />
      </g>
      <g class="visibility-markers">
        {visibilityMarkers.map(([x, y, shape], index) => (
          <g style={`--marker-delay: -${Math.floor(index / 2) * 0.32}s`} transform={`translate(${x} ${y})`}>
            {shape === "square" && <rect x="-4" y="-4" width="8" height="8" />}
            {shape === "circle" && <circle r="3.5" />}
            {shape === "plus" && <path d="M-5 0H5M0-5V5" />}
          </g>
        ))}
      </g>
      <g class="visibility-sweep">
        <rect x="-64" y="22" width="72" height="196" fill={`url(#visibility-sweep-gradient-${instanceId})`}>
          <animate attributeName="x" values="-64;472" dur="6.8s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="6.8s" repeatCount="indefinite" />
        </rect>
        <path d="M0 26V214" filter={`url(#signal-packet-glow-${variant}-${instanceId})`}>
          <animateTransform attributeName="transform" type="translate" values="-36 0;516 0" dur="6.8s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="6.8s" repeatCount="indefinite" />
        </path>
      </g>
    </>
  )}

  {variant === "win" && (
    <>
      <g class="convergence-lines">
        {winLanes.map((y, index) => (
          <path class:list={[`lane-tone-${index % 3}`]} d={`M18 ${y}H142C184 ${y} 190 120 226 120`} />
        ))}
        {winLanes.map((y, index) => (
          <path class:list={[`lane-tone-${(index + 1) % 3}`]} d={`M254 120C290 120 296 ${y} 338 ${y}H462`} />
        ))}
      </g>
      <g class="convergence-packets">
        {[42, 94, 146, 198].map((y, index) => (
          <g class="signal-packet" filter={`url(#signal-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-6" cy="0" rx="8" ry="1.7" />
            <circle class="signal-packet-halo" r="5" />
            <circle class="signal-packet-core" r="1.7" />
            <animateMotion path={`M18 ${y}H142C184 ${y} 190 120 226 120`} dur={`${4.8 + index * 0.3}s`} begin={`-${index * 1.1}s`} rotate="auto" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.88;1" dur={`${4.8 + index * 0.3}s`} begin={`-${index * 1.1}s`} repeatCount="indefinite" />
          </g>
        ))}
        {[68, 120, 172].map((y, index) => (
          <g class="signal-packet" filter={`url(#signal-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-6" cy="0" rx="8" ry="1.7" />
            <circle class="signal-packet-halo" r="5" />
            <circle class="signal-packet-core" r="1.7" />
            <animateMotion path={`M254 120C290 120 296 ${y} 338 ${y}H462`} dur={`${4.7 + index * 0.4}s`} begin={`-${index * 1.3 + 0.7}s`} rotate="auto" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.88;1" dur={`${4.7 + index * 0.4}s`} begin={`-${index * 1.3 + 0.7}s`} repeatCount="indefinite" />
          </g>
        ))}
      </g>
      <g class="convergence-nodes">
        {[68, 120, 172].map((y) => <circle cx="92" cy={y} r="3.5" />)}
        {[42, 94, 146, 198].map((y) => <circle cx="388" cy={y} r="3.5" />)}
        <rect class="convergence-core-outer" x="224" y="104" width="32" height="32" rx="3" />
        <rect class="convergence-core-inner" x="231" y="111" width="18" height="18" rx="2" />
      </g>
    </>
  )}

  {variant === "keep" && (
    <>
      <g class="retention-loops">
        <path class="retention-outer" pathLength="100" d={loopOuter} />
        <path class="retention-inner" pathLength="100" d={loopInner} />
      </g>
      <g class="retention-packets">
        {[loopOuter, loopInner].map((path, index) => (
          <g class="signal-packet" filter={`url(#signal-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-7" cy="0" rx="9" ry="1.8" />
            <circle class="signal-packet-halo" r="5.5" />
            <circle class="signal-packet-core" r="1.8" />
            <animateMotion path={path} dur={index === 0 ? "8.6s" : "6.8s"} begin={index === 0 ? "-2s" : "-5s"} rotate="auto" repeatCount="indefinite" />
          </g>
        ))}
      </g>
      <g class="retention-arrows">
        <path d="M246 42l-10-6m10 6-10 6" />
        <path class="is-blue" d="M234 176l10-6m-10 6 10 6" />
      </g>
    </>
  )}

  {variant === "accent" && (
    <>
      <g class="accent-flow-lines">
        {accentBranches.map((branch) => <path d={branch.d} />)}
      </g>
      <g class="accent-flow-packets">
        {accentBranches.filter((_, index) => index % 4 === 0).map((branch, index) => (
          <g class="signal-packet" filter={`url(#signal-packet-glow-${variant}-${instanceId})`}>
            <ellipse class="signal-packet-tail" cx="-7" cy="0" rx="10" ry="1.8" />
            <circle class="signal-packet-halo" r="5.5" />
            <circle class="signal-packet-core" r="1.8" />
            <animateMotion path={branch.d} dur={`${7.2 + index * 0.5}s`} begin={`-${index * 1.4}s`} rotate="auto" repeatCount="indefinite" />
          </g>
        ))}
      </g>
    </>
  )}
</svg>
