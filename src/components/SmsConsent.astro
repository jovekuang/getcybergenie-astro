---
import { sms } from "@/data/sms";
import { brand } from "@/data/brand";
const { id = "sms-consent" } = Astro.props;
---
<div class="sms-consent">
  <label for={id}>
    <input id={id} type="checkbox" name="smsConsent" value="true" aria-describedby={`${id}-policies`} />
    <span>{sms.consent}</span>
  </label>
  <p id={`${id}-policies`}>
    Cyber Genie texting number: {sms.keywordDisplayPhone}.
    <a href="/terms/#sms">SMS Terms</a> · <a href="/privacy/#sms">Privacy Policy</a>.
    For help, email <a href={`mailto:${brand.publicEmail}`}>{brand.publicEmail}</a>.
    Mobile information and SMS consent are not sold or shared with third parties or affiliates for marketing or promotional purposes.
  </p>
</div>
<style>
  .sms-consent { margin: 1.5rem 0; padding: 1.25rem; border: 1px solid #DDE5DF; border-radius: 12px; background: #FBFAF7; color: #182823; }
  .sms-consent label { display: flex; align-items: flex-start; gap: .8rem; font-size: .95rem; line-height: 1.65; cursor: pointer; }
  .sms-consent input { flex: 0 0 auto; width: 22px; height: 22px; margin: .2rem 0 0; accent-color: #0F766E; }
  .sms-consent input:focus-visible { outline: 3px solid #6D5DD3; outline-offset: 3px; }
  .sms-consent p { margin: .8rem 0 0; font-size: .875rem; line-height: 1.65; }
  .sms-consent a { color: #0F766E; text-decoration: underline; text-underline-offset: 3px; }
</style>
