---
import CustomerStory from "@/components/customer-stories/CustomerStory.astro";
import { publishedStories } from "@/data/customer-stories";
import type { CaseStudy } from "@/data/customer-stories/types";
export function getStaticPaths() {
  return publishedStories.map((study, index) => ({
    params: { slug: study.slug },
    props: { study, other: publishedStories[(index + 1) % publishedStories.length] },
  }));
}
interface Props { study: CaseStudy; other: CaseStudy; }
const { study, other } = Astro.props;
---
<CustomerStory study={study} other={other} review={false} />
