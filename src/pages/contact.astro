---
import { brand } from "@/data/brand";
import { appUrl } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calendlyUrl, createBreadcrumbSchema } from "@/data/site";
import { customerOsCore, membershipPlans, technologyPartnerOffer } from "@/data/solutions";
import { staticSeo } from "@/data/seo";
import SmsConsent from "@/components/SmsConsent.astro";
import { sms } from "@/data/sms";

const essential = membershipPlans.find((plan) => plan.slug === "essential-website")!;
const evolving = membershipPlans.find((plan) => plan.slug === "evolving-website")!;
---

<BaseLayout
  title={staticSeo.contact.title}
  description={staticSeo.contact.description}
  canonical="/contact/"
  jsonLd={createBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact/" },
  ])}
>
  <section class="hero compact-hero">
    <div class="container hero-centered">
      <h1 class="compact-title">Tell us what should work better.</h1>
      <p class="lead">Show us where the work gets stuck. We’ll help find the right starting point.</p>
      <a class="contact-email" href={`mailto:${brand.publicEmail}`}>{brand.publicEmail}</a>
      <p><a href={`tel:${sms.phone}`}>Call {sms.displayPhone}</a> or <a href="#message">send us a message</a>.</p>
      <p class="portal-continuity">Already a customer? Your existing FK Innovate account still works.</p>
    </div>
  </section>

  <section class="section" id="message" aria-labelledby="message-title">
    <div class="container contact-form-container">
      <h2 id="message-title">Send us a message.</h2>
      <p>Tell us what you need help with. If you prefer text updates about your request, you can opt in below.</p>
      <aside class="sms-keyword" aria-labelledby="sms-keyword-title" data-disclosure-version={sms.keywordVersion}>
        <h3 id="sms-keyword-title">Prefer to start by text?</h3>
        <p>{sms.keywordDisclosure} Terms: <a href="/terms/#sms">https://getcybergenie.com/terms/#sms</a> Privacy: <a href="/privacy/#sms">https://getcybergenie.com/privacy/#sms</a></p>
        <a class="button button-secondary" href={`sms:${sms.phone}?body=YES`}>Text YES to {sms.displayPhone}</a>
        <p>For help, email <a href={`mailto:${brand.publicEmail}`}>{brand.publicEmail}</a>. Mobile information and SMS consent are not sold or shared with third parties or affiliates for marketing or promotional purposes.</p>
      </aside>
      <noscript><style>#contact-form { display: none; }</style><p>Email <a href={`mailto:${brand.publicEmail}`}>{brand.publicEmail}</a> or call <a href={`tel:${sms.phone}`}>{sms.displayPhone}</a> to reach us.</p></noscript>
      <form id="contact-form" method="post" action="/api/contact">
        <div class="onboarding-honeypot" aria-hidden="true"><label for="contact-website">Leave this blank</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="startedAt" />
        <input type="hidden" name="submissionId" />
        <div class="contact-form-fields">
          <div class="form-field"><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="160" /></div>
          <div class="form-field"><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="160" /></div>
          <div class="form-field"><label for="contact-phone">Mobile phone <span>Optional</span></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /><p class="contact-field-note">Providing a number alone does not opt you in to texts.</p></div>
          <div class="form-field"><label for="contact-message">How can we help?</label><textarea id="contact-message" name="message" rows="5" required maxlength="2400"></textarea></div>
        </div>
        <SmsConsent id="contact-sms-consent" />
        <p class="contact-field-note">We use your information to respond to your request. Submitting an inquiry does not place an order. See our <a href="/privacy/">Privacy Policy</a> and <a href="/terms/">Terms</a>.</p>
        <button class="button button-primary" type="submit">Send message</button>
      </form>
      <p id="contact-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-option-grid">
      <article class="card contact-option contact-option-featured">
        <p class="customer-os-status">Done for you</p>
        <h2>{technologyPartnerOffer.name}</h2>
        <p>Process mapping, connected tools, and ongoing management across agreed business systems.</p>
        <a class="button button-primary" href={technologyPartnerOffer.ctaHref}>{technologyPartnerOffer.cta}</a>
      </article>
      <div class="contact-options-intro">
        <h2>Prefer to begin with one or two parts?</h2>
        <p>Start with the service you need now.</p>
      </div>
      <article class="card contact-option">
        <h2>Essential Website</h2>
        <p>A focused custom website with up to 10 published pages and ongoing changes.</p>
        <a class="button button-primary" href={essential.ctaHref}>Start onboarding</a>
      </article>
      <article class="card contact-option">
        <h2>{evolving.name}</h2>
        <p>One evolving application with integrations, a backend database, single sign-on, and recurring content.</p>
        <a class="button button-primary" href={evolving.ctaHref}>Start onboarding</a>
      </article>
      <article class="card contact-option">
        <h2>Voice AI</h2>
        <p>A personalized demo within 1 business day of intake. Agent setup, required workflow integrations, and testing are handled.</p>
        <a class="button button-secondary" href={`${appUrl}/login?service=voice`}>Request a free demo</a>
      </article>
      <article class="card contact-option">
        <h2>Social Media Management</h2>
        <p>Choose your content cadence and channels.</p>
        <a class="button button-secondary" href="/services/marketing/">View social plans</a>
      </article>
      <article class="card contact-option">
        <h2>Not sure yet?</h2>
        <p>Talk through the bottleneck without committing to a larger engagement.</p>
        <a class="button button-secondary" href={calendlyUrl}>Talk through the process</a>
      </article>
      <div class="contact-options-intro">
        <h2>{customerOsCore.name} is included.</h2>
        <p>CRM and self-service tools, included while any paid Cyber Genie service is active. <a href="/solutions/keep-customers/customer-management/">Explore Customer OS</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");
  if (form && status) {
    const startedAt = form.elements.namedItem("startedAt") as HTMLInputElement;
    const submissionId = form.elements.namedItem("submissionId") as HTMLInputElement;
    const phone = form.elements.namedItem("phone") as HTMLInputElement;
    const consent = form.elements.namedItem("smsConsent") as HTMLInputElement;
    startedAt.value = String(Date.now());
    // Reuse this identity on network retries, including a reload of the same tab.
    const storageKey = "cyber-genie-contact-submission";
    let pending: { id: string; fields: string } | null = null;
    try { pending = JSON.parse(sessionStorage.getItem(storageKey) || "null"); } catch { /* Storage may be unavailable. */ }
    const validatePhone = () => {
      phone.setCustomValidity(consent.checked && !/^(?:1)?[2-9]\d{2}[2-9]\d{6}$/.test(phone.value.replace(/[\s()+.-]/g, "")) ? "Enter a valid US mobile number to receive text messages, or leave SMS consent unchecked." : "");
    };
    phone.addEventListener("input", validatePhone);
    consent.addEventListener("change", validatePhone);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      validatePhone();
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      status.hidden = true;
      const data = new FormData(form);
      const fieldBytes = new TextEncoder().encode(JSON.stringify({ name: data.get("name"), email: data.get("email"), phone: data.get("phone"), message: data.get("message"), smsConsent: consent.checked }));
      const fields = Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256", fieldBytes)), b => b.toString(16).padStart(2, "0")).join("");
      if (!pending || pending.fields !== fields) pending = { id: crypto.randomUUID(), fields };
      submissionId.value = pending.id;
      data.set("submissionId", pending.id);
      try { sessionStorage.setItem(storageKey, JSON.stringify(pending)); } catch { /* In-memory identity still protects same-page retries. */ }
      try {
        const response = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ...Object.fromEntries(data), smsConsent: consent.checked }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || "Your message could not be sent. Please try again.");
        status.textContent = result.dryRun ? "Preview only. No request was sent and no SMS consent was recorded." : "Thank you. Your message has been received. Check your email for an introduction to Cyber Genie and a link to book a conversation.";
        try { sessionStorage.removeItem(storageKey); } catch { /* No persistent identity to clear. */ }
        form.hidden = true;
      } catch (error) { status.textContent = error instanceof Error ? error.message : "Your message could not be sent. Please try again."; }
      status.hidden = false;
      status.focus();
      button.disabled = false;
    });
  }
</script>
<style>
  .contact-form-container { max-width: 780px; }
  .sms-keyword { margin: 1.5rem 0 2rem; padding: 1.5rem; background: #E7F5F0; border: 1px solid #DDE5DF; border-radius: 12px; }
  .sms-keyword h3 { margin: 0 0 .75rem; }
  .sms-keyword p { font-size: .95rem; line-height: 1.7; margin: .75rem 0; }
  .sms-keyword a { overflow-wrap: anywhere; }
  .sms-keyword .button { margin: .5rem 0; white-space: normal; text-align: center; }
  .contact-form-fields { display: grid; gap: 1.25rem; margin-top: 2rem; }
  .contact-field-note { font-size: .875rem; line-height: 1.6; color: #57655F; margin-top: .5rem; }
  #contact-form button { margin-top: 1rem; }
  #contact-status { padding: 1.25rem; border: 1px solid #DDE5DF; border-radius: 12px; background: #E7F5F0; }
</style>
