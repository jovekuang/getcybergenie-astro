---
import { brand } from "@/data/brand";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { blogPosts } from "@/data/blogData";
import { createBreadcrumbSchema, organizationSchema } from "@/data/site";
import { staticSeo } from "@/data/seo";
import { Image } from "astro:assets";

const posts = [...blogPosts].sort((a, b) => Date.parse(b.date) - Date.parse(a.date));

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${brand.origin}/blog/#blog`,
  name: "Cyber Genie Blog",
  url: `${brand.origin}/blog/`,
  description: staticSeo.blog.description,
  inLanguage: "en-US",
  publisher: { "@id": organizationSchema["@id"] },
};
---

<BaseLayout
  title={staticSeo.blog.title}
  description={staticSeo.blog.description}
  canonical="/blog/"
  jsonLd={[
    organizationSchema,
    blogSchema,
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Blog", path: "/blog/" },
    ]),
  ]}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="page-title">
        <span class="headline-sentence headline-sentence-neutral">Technology &amp; AI.</span>
        <span class="headline-sentence">For small businesses.</span>
      </h1>
      <p class="lead">Practical ideas about better websites, useful software, and customer workflows that fit how the business already works.</p>
    </div>
  </section>
  <section class="section">
    <div class="container blog-grid">
      {posts.map((post) => (
        <a class="card media-card blog-card" href={`/blog/${post.slug}/`}>
          <Image
            src={post.image}
            alt={post.imageAlt ?? post.title}
            widths={[480, 760, 1100, 1200]}
            sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 860px) calc(100vw - 40px), (max-width: 1240px) calc((100vw - 84px) / 3), 386px"
            loading="lazy"
          />
          <div class="blog-card-body">
            <p class="eyebrow">{post.category}</p>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
            <p style="font-size: 14px;"><time datetime={post.date}>{post.date}</time> · {post.readTime}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
