---
import { brand } from "@/data/brand";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getImage, Image } from "astro:assets";
import { blogPosts } from "@/data/blogData";
import { createBreadcrumbSchema } from "@/data/site";
import emailAuthDiagram from "@/assets/blog-email-auth-spf-dkim-dmarc.png";

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const historicalBrand = ["evolving-website-and-technology-partner", "introducing-voice-ai-service-new-software-small-business"].includes(post.slug);
const seoDescription = post.seoDescription ?? post.excerpt;
const socialImage = await getImage({
  src: post.image,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "webp",
  quality: 82,
});
const relatedPosts = blogPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .sort((a, b) => Number(b.category === post.category) - Number(a.category === post.category))
  .slice(0, 3);
const articleContext = `${post.title} ${post.excerpt} ${post.category}`.toLowerCase();
const relatedService = articleContext.includes("preparation") || articleContext.includes("project update")
  ? { name: "Project Updates", href: "/solutions/keep-customers/project-updates/" }
  : articleContext.includes("tour") || articleContext.includes("scheduling")
  ? { name: "Scheduling", href: "/solutions/win-customers/scheduling/" }
  : articleContext.includes("estimate") || articleContext.includes("quote")
  ? { name: "Quoting & Follow-Up", href: "/solutions/win-customers/quoting-follow-up/" }
  : articleContext.includes("social") || articleContext.includes("marketing")
  ? { name: "Social Media Management", href: "/services/marketing/" }
  : articleContext.includes("voice") || articleContext.includes("call") || articleContext.includes("phone")
    ? { name: "Voice AI", href: "/services/voice/" }
    : articleContext.includes("spreadsheet") || articleContext.includes("business software") || articleContext.includes("business app") || articleContext.includes("technology")
      ? { name: "Technology Partner", href: "/services/technology-partner/" }
    : articleContext.includes("website") || articleContext.includes("web application")
      ? { name: "Evolving Web Application", href: "/services/website-design-hosting/" }
      : { name: "Technology Partner", href: "/services/technology-partner/" };

const blocks = post.content
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean);

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const renderInlineMarkdown = (value: string) =>
  escapeHtml(value).replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+|\/[^)\s]+)\)/g,
    (_match, label, href) => `<a href="${href}">${label}</a>`,
  );

const articleImages: Record<string, string> = {
  "/blog-images/blog-email-auth-spf-dkim-dmarc.png": emailAuthDiagram.src,
};

const getImageBlock = (value: string) => {
  const match = value.match(/^!\[([^\]]+)\]\((\/[^)\s]+)\)$/);
  if (!match || !articleImages[match[2]]) return null;

  return { alt: match[1], src: articleImages[match[2]] };
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: seoDescription,
  keywords: post.keywords,
  datePublished: post.date,
  author: {
    "@type": "Person",
    name: post.author,
  },
  publisher: {
    "@id": `${brand.origin}/#organization`,
  },
  image: {
    "@type": "ImageObject",
    url: new URL(socialImage.src, Astro.site ?? brand.origin).toString(),
    width: 1200,
    height: 630,
  },
  url: `${brand.origin}/blog/${post.slug}/`,
  mainEntityOfPage: `${brand.origin}/blog/${post.slug}/`,
};
const faqSchema = post.faq?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;

const isHeading = (block: string) =>
  block.length < 80 &&
  !block.endsWith(".") &&
  !block.endsWith("?") &&
  !block.includes("[") &&
  !block.startsWith("http");
---

<BaseLayout
  title={post.seoTitle ?? `${post.title} | Cyber Genie`}
  description={seoDescription}
  canonical={`/blog/${post.slug}/`}
  image={socialImage.src}
  imageAlt={post.title}
  type="article"
  jsonLd={[
    articleSchema,
    ...(faqSchema ? [faqSchema] : []),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Blog", path: "/blog/" },
      { name: post.title, path: `/blog/${post.slug}/` },
    ]),
  ]}
>
  <article class="article">
    <p class="eyebrow">{post.category}</p>
    <h1>{post.title}</h1>
    <p class="lead">{post.excerpt}</p>
    <p style="color: var(--muted);">{post.date} · {post.author} · {post.readTime}</p>
    <Image
      src={post.image}
      alt={post.title}
      class="article-hero-image"
      widths={[640, 820, 1200]}
      sizes="(max-width: 860px) 92vw, 820px"
      loading="eager"
    />
    {historicalBrand && <aside class="brand-history-note">Originally published under FK Innovate. The same team now provides these services as Cyber Genie; the original launch story is preserved below.</aside>}
    <div class="article-content">
      {blocks.map((block) => {
        const image = getImageBlock(block);

        if (image) {
          return <img class="article-inline-image" src={image.src} alt={image.alt} loading="lazy" />;
        }

        return isHeading(block)
          ? <h2>{block}</h2>
          : <p set:html={renderInlineMarkdown(block)} />;
      })}
    </div>

    {post.faq?.length && (
      <section class="article-content article-faq" aria-labelledby="article-faq-heading">
        <h2 id="article-faq-heading">{post.faqHeading ?? 'Frequently asked questions'}</h2>
        {post.faq.map((item) => (
          <div>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
      </section>
    )}

    <aside class="article-next-step" aria-label="Related Cyber Genie service">
      <h2>Turn the idea into a customer workflow.</h2>
      <p>See how {relatedService.name} can become a focused starting point or connect the process and technology behind the work.</p>
      <a class="button button-secondary" href={relatedService.href}>Explore {relatedService.name}</a>
    </aside>

    <section class="article-related" aria-labelledby="related-reading-heading">
      <h2 id="related-reading-heading">Related reading</h2>
      <div class="article-related-list">
        {relatedPosts.map((related) => (
          <a href={`/blog/${related.slug}/`}>
            <strong>{related.title}</strong>
            <span>{related.readTime}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="article-author">
      <strong>Written by {post.author}</strong>
      <p>Cyber Genie translates messy customer and operating workflows into systems businesses can actually use.</p>
      <a class="learn-more" href="/about/">About Cyber Genie <span aria-hidden="true">→</span></a>
    </div>
  </article>
</BaseLayout>
