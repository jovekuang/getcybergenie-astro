---
import {draftMotion} from "./draft-config.mjs";
import {copy,guideContact as contact,channels} from "./draft-fixtures";
import careMobile from "../case-studies/media/motion/edencare-mobile-site.webp";
import careSite from "../case-studies/media/edencare-current-site.jpg";
import carePoster from "../case-studies/media/edencare-poster.jpg";
import guide from "../case-studies/media/guide-cover.jpg";
import wabiSite from "../case-studies/media/wabi-blobi-current-site.jpg";
import wabiMark from "../case-studies/media/motion/wabi-mark.svg";
import reelA from "../case-studies/media/motion/wabi-reel-a-poster.jpg";
import reelB from "../case-studies/media/motion/wabi-reel-b-poster.jpg";
import brucePoster from "../case-studies/media/motion/bruce-footage-poster.jpg";
import "@fontsource/inter/400.css";import "@fontsource/inter/600.css";import "@fontsource/inter/700.css";import "@fontsource/manrope/700.css";
import "./stage.css";import "./draft-stages.css";
export function getStaticPaths(){return Object.entries(draftMotion).flatMap(([story,config])=>config.scenes.map(scene=>({params:{story,scene}})));}
const story=Astro.params.story as keyof typeof copy;
const scene=Astro.params.scene!;
const index=draftMotion[story].scenes.indexOf(scene);
const [kicker,title,body]=copy[story][index];
const bruce=story==="eden-elevations-3",ava=story==="wabi-blobi";
const brand=bruce?"EDEN ELEVATIONS 3":ava?"Wabi Blobi":"EdenCare 360";
const website=ava?"wabiblobi.com":"edencare360.com";
const site=ava?wabiSite:careSite;
const concept=bruce?scene!=="walkthrough":!ava&&["request","options"].includes(scene);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'none'; connect-src 'none'; form-action 'none'; frame-src 'none'"/><title>{brand} — local {scene} scene</title></head><body>
<main class:list={["stage","draft-stage",bruce?"bruce":ava?"ava":"edith",`scene-${scene}`]} data-demo-only>
<header class="stage-top"><div class="draft-brand">{ava?<img src={wabiMark.src} alt="Wabi Blobi"/>:<strong>{brand}<small>{bruce?"REAL ESTATE · ELEVATED":"PERSONALIZED CARE · REIMAGINED"}</small></strong>}</div><span>THOUGHTFULLY CONNECTED <i></i> CYBER GENIE</span></header>
<div class="editorial"><p class="eyebrow">0{index+1} / {kicker}</p><h1>{title.split(" ").map(line=><span>{line}</span>)}</h1><p class="deck">{body}</p></div>
{scene==="website"?<div class="draft-web"><div class="desktop-site"><div class="window-chrome"><span><i></i><i></i><i></i></span><span>{website}</span><span>◇</span></div><img src={site.src} alt="Original public website"/></div><div class="site-phone"><div class="phone-notch"></div><img src={(ava?site:careMobile).src} alt={ava?"Website detail in a mobile frame":"Actual EdenCare 360 mobile homepage with a responsive heading"}/></div></div>:
 scene==="walkthrough"?<div class="walkthrough-device"><div class="window-chrome"><span><i></i><i></i><i></i></span><span>edenelevations3.com · scrolling hero</span><span>◇</span></div><div class="video-slot walkthrough-slot" data-video-slot><img src={brucePoster.src} alt="Original scroll-controlled walkthrough footage"/></div><div class="walkthrough-progress"><span>SCROLL TO EXPLORE</span><i></i><b>↓</b></div></div>:
 scene==="guide"?<div class="guide-composition"><img class="guide-cover" src={guide.src} alt="Actual Keep More of What You Earn tax guide cover"/><div class="demo-form"><p class="micro">REQUEST THE TAX GUIDE</p><h2>Keep more of<br/>what you earn.</h2><div class="fake-field"><small>Name</small><strong>{contact.name}</strong></div><div class="fake-field"><small>Email</small><strong>{contact.email}</strong></div><div class="pill-action">Get the free guide →</div><span class="tiny-label">Fictional request · No submission</span></div></div>:
 scene==="flow"?<div class="flow-composition"><div class="flow-card resource"><img src={guide.src} alt="Tax guide"/><strong>Tax guide request</strong><span>{contact.name}</span></div><div class="flow-arrow">······· →</div><div class="flow-card crm"><div class="big-icon">▤</div><small>CONNECTED CRM</small><h2>Interest, with<br/>its context.</h2><div class="source-tag">Source: {contact.source}</div><p>{contact.email}</p></div></div>:
 scene==="contact"?<div class="contact-composition"><div class="draft-contact"><p class="micro">EXAMPLE CONTACT RECORD</p><div class="identity"><b>JW</b><div><h2>{contact.name}</h2><span>{contact.id}</span></div></div><div class="source-tag">Inquiry source: {contact.source}</div><p>{contact.email}<br/>{contact.phone}</p><div class="record-event"><small>{contact.date}</small><strong>Requested the tax guide</strong></div></div><div class="draft-followup"><span class="big-icon">◷</span><p class="micro">EXAMPLE NEXT STEP</p><h2>Pick up the<br/>conversation.</h2><p>Follow up about the guide.</p><div>{contact.followup}</div><small>Illustrated follow-up action</small></div></div>:
 scene==="production"?<div class="production-composition"><div class="photo-files"><div>▧<span>Photo 01</span></div><div>▧<span>Photo 02</span></div><div>▧<span>Photo 03</span></div></div><div class="production-arrow">↓</div><div class="hero-device"><div class="window-chrome"><span><i></i><i></i><i></i></span><span>The finished hero video</span><span>▶</span></div><div class="video-slot care-slot" data-video-slot><img src={carePoster.src} alt="Original EdenCare 360 hero video"/></div></div></div>:
 scene==="request"?<div class="request-composition"><div class="message-bubble"><p class="micro">EXAMPLE UPDATE REQUEST</p><h2>“Can we make the welcome headline feel more personal?”</h2><span>Small website update</span></div><div class="headline-card"><small>CURRENT EXAMPLE</small><h2>Welcome to<br/>EdenCare 360.</h2><div>WEBSITE WELCOME HEADING</div></div></div>:
 scene==="options"?<div class="options-composition"><div class="update-options"><div><span>↗</span><strong>Ask the team</strong><small>Describe it. We handle the update.</small></div><b>OR</b><div><span>✧</span><strong>Make a small AI edit</strong><small>Use the self-service option.</small></div></div><div class="options-arrow">↓</div><div class="updated-heading"><small>EXAMPLE UPDATED HEADING</small><h2>Care that starts<br/>with you.</h2><p>EdenCare 360</p></div></div>:
 scene.startsWith("reel-")?<div class="reel-composition"><div class="reel-device"><div class="reel-top"><span>WABI BLOBI / ORIGINAL CREATIVE</span><i></i></div><div class="video-slot reel-slot" data-video-slot><img src={(scene==="reel-a"?reelA:reelB).src} alt="Original Wabi Blobi Reel artwork"/></div></div><div class="reel-side"><span>FROM A WATERCOLOR BLOB</span><strong>To a new<br/>possibility.</strong><p>Creative Reels<br/>by Cyber Genie</p><i>✧</i></div></div>:
 <div class="calendar-composition"><div class="calendar-title"><div><small>ILLUSTRATIVE PUBLISHING SETUP</small><h2>Social content calendar</h2></div><span>May 2027</span></div><div class="channel-strip">{channels.map((channel,i)=><span><b>{["f","◎","P","♪","▶"][i]}</b>{channel}</span>)}</div><div class="publishing-grid">{["MON 10","TUE 11","WED 12","THU 13","FRI 14"].map((day,i)=><div class="publishing-day"><strong>{day}</strong>{[1,3].includes(i)&&<div class="example-post"><img src={(i===1?reelA:reelB).src} alt="Reel artwork thumbnail"/><small>{i===1?"10:00 AM":"4:30 PM"}</small><h3>{i===1?"What do you see?":"A new way to imagine"}</h3><div>f &nbsp; ◎ &nbsp; P &nbsp; ♪ &nbsp; ▶</div><span>Example schedule</span></div>}</div>)}</div><div class="calendar-bottom">Plan together. Schedule ahead. <span>Five channels, one place.</span></div></div>}
<footer class="stage-footer"><span class="demo-label"><i></i>{concept?"Demo using fictional data":scene==="calendar"?"Illustrated calendar · Fictional schedule":"Original client creative"}</span><span>{concept?"Conceptual workflow illustration":scene==="production"?"Photo files are illustrative":scene==="calendar"?"Publishing platform provisioned by Cyber Genie":"Website design & creative production"}</span><div class="scene-dots">{draftMotion[story].scenes.map(s=><i class:list={{active:s===scene}}></i>)}</div></footer>
</main></body></html>
