---
import {family,familyCounts,event,storyScenes} from "../../customer-fixtures";
import firstLogo from "../../media/first-achievers-mark.png";
import firstSite from "../../../../assets/customer-stories/first-achievers-current-site.jpg";
import firstMobile from "../../media/first-achievers-site-mobile.jpg";
import warehouseMobile from "../../media/warehouse-site-mobile.jpg";
import warehouseLogo from "../../../../assets/customer-stories/warehouse-mark.png";
import warehouseSite from "../../../../assets/customer-stories/warehouse-current-site.png";
import "@fontsource/inter/400.css";import "@fontsource/inter/500.css";import "@fontsource/inter/600.css";import "@fontsource/inter/700.css";import "@fontsource/manrope/700.css";
import "../../stage.css";import "../../customer-stages.css";
export function getStaticPaths(){return Object.entries(storyScenes).flatMap(([story,scenes])=>scenes.map(scene=>({params:{story,scene:scene.key}})));}
const story=Astro.params.story as keyof typeof storyScenes;
const scene=Astro.params.scene!;
const scenes=storyScenes[story];
const copy=scenes.find(s=>s.key===scene)!;
const first=story==="first-achievers";
const logo=first?firstLogo:warehouseLogo;
const site=first?firstSite:warehouseSite;
const days=Array.from({length:31},(_,i)=>i+1);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'none'; connect-src 'none'; form-action 'none'; frame-src 'none'"/><title>Fictional {story} demonstration — {scene}</title></head><body>
<main class:list={["stage","customer-stage",first?"first-stage":"warehouse-stage",`customer-scene-${scene}`]} data-demo-only>
 <header class="stage-top"><div class="customer-brand"><img src={logo.src} alt={first?"First Achievers Childcare":"The Warehouse by Black Creek"}/>{!first&&<strong>THE WAREHOUSE<small>BY BLACK CREEK</small></strong>}</div><span>CONNECTED CUSTOMER CARE <i></i> CYBER GENIE</span></header>
 <div class="editorial"><p class="eyebrow">0{scenes.indexOf(copy)+1} / {copy.kicker}</p><h1>{copy.title.split("\n").map((line,index)=><span>{index>0?" ":""}{line}</span>)}</h1><p class="deck">{copy.body.split("\n").map((line,index)=><span>{index>0?" ":""}{line}</span>)}</p></div>
 {scene==="website"?<div class="website-composition"><div class="website-browser"><div class="window-chrome"><span><i></i><i></i><i></i></span><span>{first?"firstachieverschildcare.com":"thewarehousebyblackcreek.com"}</span><span>◇</span></div><img src={site.src} alt="Current public website"/></div><div class="website-phone"><div class="phone-camera"></div><img src={(first?firstMobile:warehouseMobile).src} alt={first?"Actual First Achievers mobile homepage":"Actual Warehouse mobile hero and venue content"}/></div></div>:
 first?<div class="customer-app">
  {scene!=="inquiry" && <aside class="first-sidebar"><div class="side-brand"><img src={firstLogo.src} alt="First Achievers"/></div><p>ADMIN CRM</p><span class:list={{chosen:scene!=="calendar"}}>▦ &nbsp; Dashboard</span><span>♧ &nbsp; Inquiries</span><span class:list={{chosen:scene==="calendar"}}>▣ &nbsp; Tour Calendar</span><span>✉ &nbsp; Email Templates</span><span>◷ &nbsp; Email Campaigns</span><small>demo.staff@example.com</small></aside>}
  <section class="first-workspace"><div class="first-app-top"><strong>{scene==="inquiry"?"First Achievers Childcare":"First Achievers CRM"}</strong><span>{scene==="inquiry"?"Schedule a Tour":"Admin"}</span></div><div class="first-body">
   {scene==="inquiry"?<><p class="ui-kicker">ONLINE TOUR SCHEDULING</p><h2>Schedule a Tour</h2><div class="tour-picker"><h3>Choose a tour time</h3><p>May 10–16, 2027 · Central Time</p><div class="date-options">{[10,11,12,13,14].map((d,i)=><div class:list={{chosen:d===12}}><small>{["MON","TUE","WED","THU","FRI"][i]}</small><b>{d}</b></div>)}</div><div class="time-options"><span class="chosen">10:00 AM</span><span>11:30 AM</span><span>2:00 PM</span></div></div><div class="family-fields"><div><small>Parent / guardian</small><strong>{family.parent}</strong></div><div><small>Child</small><strong>{family.child}</strong></div><div><small>Email</small><strong>{family.email}</strong></div><div><small>Phone</small><strong>{family.phone}</strong></div></div></>:
   scene==="calendar"?<><p class="ui-kicker">OVERVIEW</p><h2>CRM Dashboard</h2><div class="first-metrics">{[[familyCounts.active,"Active inquiries"],[familyCounts.new,"New inquiries"],[familyCounts.applied,"Applied or pending"],[familyCounts.tours,"Upcoming tours"]].map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div><div class="visit-card"><div class="visit-heading"><h3>Upcoming tours</h3><span>View calendar →</span></div><div class="family-visit"><div class="person-initials">MB</div><div><h3>{family.parent}</h3><p>Child: {family.child}</p></div><div><strong>{family.tourTime}</strong><p>May 12, 2027</p><span class="ui-badge">Scheduled</span></div></div></div><div class="tour-calendar-strip"><span>TOUR CALENDAR</span><strong>{family.tourDate}</strong><p>{family.tourTime} · {family.parent}</p></div></>:
   <><p class="ui-kicker">FAMILY INQUIRY</p><h2>{family.parent}</h2><p class="family-ref">{family.id} · {family.email}</p><div class="tour-complete"><span>✓</span><div><h3>Tour completed</h3><p>May 12, 2027 · {family.tourTime}</p></div></div><div class="followup-email"><div class="visit-heading"><h3>Post-tour follow-up</h3><span class="ui-badge">Scheduled</span></div><p class="email-to">To: {family.email}</p><p>Hi Maya, thank you for visiting First Achievers. We’d love to help with the next step for Noah.</p><div class="email-schedule"><span>◷</span><div><strong>{family.followupDate}</strong><p>Next follow-up · Fictional example</p></div></div></div></>}
  </div></section>
 </div>:<div class="customer-app venue-app">
  <div class="venue-app-header"><div><small>VENUE OPERATIONS</small><strong>The Warehouse</strong></div><span>Demo Staff · Admin</span></div><div class="venue-tabs"><span>Overview</span><span class:list={{chosen:scene==="inquiry"}}>Inquiries</span><span class:list={{chosen:scene!=="inquiry"}}>Calendar</span><span>Guide</span></div><section class="venue-body">
  {scene==="inquiry"?<><p class="ui-kicker">LEAD DESK</p><h2>Event inquiries</h2><div class="venue-filter"><span class="chosen">New</span><span>Converted</span><span>Dismissed</span><span>All</span></div><article class="venue-inquiry"><div class="visit-heading"><h3>{event.name}</h3><span class="venue-status">New</span></div><p>{event.type} · {event.guests} guests · May 15, 2027</p><p class="event-message">{event.message}</p><div class="event-contact"><span>{event.email}</span><span>{event.phone}</span></div><div class="venue-action">＋ Create tentative hold</div></article></>:
  scene==="hold"?<><p class="ui-kicker">CONNECTED TO THE INQUIRY</p><h2>Add calendar entry</h2><div class="hold-form"><div class="hold-fields"><div><small>Entry type</small><strong>Private booking</strong></div><div><small>Status</small><strong class="tentative-text">Tentative</strong></div><div class="full-field"><small>Calendar title</small><strong>{event.title}</strong></div><div><small>Customer</small><strong>{event.name}</strong></div><div><small>Estimated guests</small><strong>{event.guests}</strong></div><div><small>Event starts</small><strong>May 15 · {event.starts}</strong></div><div><small>Event ends</small><strong>May 15 · {event.ends}</strong></div><div><small>Setup begins</small><strong>{event.setup}</strong></div><div><small>Cleanup ends</small><strong>{event.cleanup}</strong></div></div><div class="hold-note">Tentative hold expires {event.holdExpires}</div><div class="venue-action">Save calendar entry</div></div></>:
  <><p class="ui-kicker">VENUE CALENDAR</p><h2>Holds & gatherings</h2><div class="venue-calendar"><div class="calendar-month"><h3>May 2027 <span>‹ &nbsp; ›</span></h3><div class="month-grid">{["S","M","T","W","T","F","S"].map(d=><small>{d}</small>)}{Array.from({length:6},()=> <i></i>)}{days.map(day=><span class:list={{chosen:day===15}}>{day}</span>)}</div></div><div class="calendar-agenda"><p>SATURDAY, MAY 15</p><span class="venue-status">Tentative</span><h3>{event.title}</h3><div class="agenda-customer">{event.name} · {event.guests} guests</div><strong>{event.starts} – {event.ends}</strong><div class="occupied-window"><small>OCCUPIED WINDOW</small><p>Setup {event.setup}<br/>Cleanup until {event.cleanup}</p></div><div class="staff-approval">Held for planning.<br/>Staff confirmation comes next.</div></div></div></>}
 </section></div>}
 <footer class="stage-footer"><span class="demo-label"><i></i>{copy.note}</span><span>{scene==="website"?"Website design & connected tools":"Faithful interface demonstration"}</span><div class="scene-dots">{scenes.map(s=><i class:list={{active:s.key===scene}}></i>)}</div></footer>
</main></body></html>
